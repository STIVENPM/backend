# Copy this file to an ignored .env for local Docker use. Configure production values in the deployment environment.
# Never commit populated credentials. DB_PASSWORD must match the PostgreSQL password for the selected database.

# Required in the prod profile: PostgreSQL connection and signing key (at least 32 UTF-8 bytes).
DB_HOST=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=

# Required in the prod profile: public HTTPS frontend origin and explicit HTTPS CORS origins.
APP_FRONTEND_URL=
APP_CORS_ALLOWED_ORIGINS=

# Required in the prod profile: two authorized administrator UUIDs separated by a comma.
ADMIN_USER_IDS=

# Required in the prod profile: SMTP account and host for recovery mail.
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# Required in the prod profile: Wompi environment and matching credentials.
WOMPI_ENVIRONMENT=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Optional settings with application defaults. Leave these unset unless your deployment needs them.
# PORT=                 HTTP port used by the default and prod profiles (Render supplies PORT).
# SERVER_PORT=          HTTP port used by the docker profile outside docker-compose.
# DB_PORT=              PostgreSQL port.
# MAIL_PORT=            SMTP port.
# MAIL_FROM=            Sender address; defaults to MAIL_USERNAME.
# APP_NOTIFICACIONES_PUSH_ENABLED=       Push delivery switch.
# APP_NOTIFICACIONES_EMAIL_ENABLED=      Email delivery switch.
# APP_NOTIFICACIONES_WORKER_DELAY_MS=    Notification worker interval in milliseconds.
